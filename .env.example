# Variables de entorno — copiá este archivo a .env y completá los valores.
# En Railway: van en la pestaña Variables del proyecto.

# Contraseña para entrar a la app. Si está vacía, NO hay auth (solo OK en localhost).
APP_PASSWORD=cambiame

# Secreto para firmar cookies de sesión. Generá uno largo y aleatorio.
# Podés generarlo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Ruta del archivo SQLite. En Railway poné /data/finanzas.db (mount del volumen).
# Si no lo definís, usa ./data/finanzas.db (dev local).
DB_PATH=

# Puerto del server. Railway lo setea solo, no lo definas allá.
PORT=3000
