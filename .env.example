# Variables de entorno del Worker de Cloudflare.
# Se cargan con: npx wrangler secret put NOMBRE
# Para correr local (server de Express legado), copiá este archivo a .env.

# Contraseña para entrar a la app. Si está vacía, NO hay auth.
APP_PASSWORD=cambiame

# Secreto para firmar cookies de sesión. Generá uno largo y aleatorio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
